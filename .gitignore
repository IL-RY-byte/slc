# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
.installed.cfg
*.egg

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Generated training data (large, reproducible) ─────────────────────────────
data/
dataset/
runs/                      # ultralytics training run output
*.npz
*.npy

# ── Downloaded / trained model weights (binary, large) ────────────────────────
# Exception: flutter/assets/models/*.onnx are production assets → keep those
*.pt                       # PyTorch weights (download on demand)
*.pth
*.h5
*.tflite
*.mlpackage
# ONNX files outside flutter assets
/models/*.onnx

# ── STL / mesh files generated by batch_generate_stls.py ─────────────────────
tiles/

# ── Flutter build output & generated files ────────────────────────────────────
flutter/build/
flutter/.dart_tool/
flutter/.flutter-plugins
flutter/.flutter-plugins-dependencies
flutter/pubspec.lock
flutter/.packages
flutter/android/local.properties
flutter/android/.gradle/
flutter/android/app/debug/
flutter/android/app/profile/
flutter/android/app/release/
flutter/ios/Flutter/Generated.xcconfig
flutter/ios/Flutter/flutter_export_environment.sh
flutter/ios/Flutter/ephemeral/
flutter/ios/Pods/
flutter/ios/.symlinks/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
